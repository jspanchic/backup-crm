# Empty values get a random one from `npm run local:init` in core-api; values already set are copied.
PG_SUPERUSER_PASSWORD=
CORE_OWNER_PASSWORD=
CORE_API_PASSWORD=
AUTHENTICATOR_PASSWORD=
PGRST_JWT_SECRET=
CONVERSATION_TOKEN_SECRET=
BOT_HMAC_SECRET=
WAHA_HMAC_BYTOGAM_PRUEBAS=
WAHA_API_KEY=
# Where the simulator and the local n8n listen
BOT_URL_JAVIER=http://127.0.0.1:5678/webhook/javier-core-api
WAHA_BASE_URL=http://127.0.0.1:3100
# Development identity of the panel: the sample responsible person created by the seed (not a secret)
ADMIN_DEV_SUB=00000000-0000-4000-8000-000000000001
# The private folder of the generated PDFs and the templates folder are optional.
# DOCUMENTS_DIR=./.data/documents
# TEMPLATES_DIR=

# Host ports of the local stack (loopback only). THE place to change them: the compose file, the .cmd/.ps1 scripts and core-api
# read these names. Windows reserves ranges of ports (see: netsh interface ipv4 show excludedportrange protocol=tcp) and Docker
# cannot publish a port inside one; INICIAR-PRESENTACION.cmd checks this and says which one to change.
PGPORT=15432
POSTGREST_PORT=13300
POSTGREST_TEST_PORT=13301
GOTENBERG_PORT=13302
