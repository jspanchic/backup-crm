# Copy to infra/vps/.env on the VPS (chmod 600) and fill it in there. This file has names only; never commit values.
# Generate each secret on the VPS with: openssl rand -hex 24   (hex only: it cannot break the PostgREST URI)

# --- Required: network ---
# Name of the Docker network of the existing n8n (docker network ls / docker inspect <n8n container>). Confirmed on Monday.
N8N_DOCKER_NETWORK=

# --- Required: database passwords ---
# Password of the Postgres superuser. Used only to create roles and by the one-shot migration container.
PG_SUPERUSER_PASSWORD=
# Password of the role that owns the schema; runs the migrations.
CORE_OWNER_PASSWORD=
# Password of the role core-api uses (can only run functions of schema api). At least 16 characters.
CORE_API_PASSWORD=
# Password of the role PostgREST connects with.
AUTHENTICATOR_PASSWORD=

# --- Required: signing secrets (at least 32 characters each, all different) ---
# Secret that core-api and PostgREST share to sign and verify the short-lived panel token.
PGRST_JWT_SECRET=
# Secret that signs the 15-minute conversation token sent to the bot. Only core-api needs it.
CONVERSATION_TOKEN_SECRET=
# Secret for the HMAC core-api -> n8n (headers X-Core-Timestamp / X-Core-Signature). n8n needs the same value.
BOT_HMAC_SECRET=

# --- Bot (n8n) ---
# Webhook URL of the TEST copy of Javier v4 inside the Docker network of n8n (http://<n8n container>:5678/webhook/<path>). Empty = the bot is not called.
BOT_URL_JAVIER=
# Secret of the test WhatsApp channel (the sample channel reads it by this name). Only needed to receive WAHA webhooks.
WAHA_HMAC_BYTOGAM_PRUEBAS=

# --- WhatsApp (leave empty: outgoing messages then fail without touching real WhatsApp) ---
# Base URL of WAHA. Empty = points at nothing. Set it only for ONE controlled test (see the guide).
WAHA_BASE_URL=
# API key of WAHA, if it asks for one. Empty = no header.
WAHA_API_KEY=
# Minimum and maximum pause in milliseconds between outgoing messages. Empty = 2000 and 5000.
OUTBOX_PACE_MIN_MS=
OUTBOX_PACE_MAX_MS=

# --- Optional ---
# Port of the panel on the VPS loopback (127.0.0.1). Empty = 8088.
PANEL_PORT=
# Identity the panel acts as (uuid of the sample responsible person from the seed; not a secret). Empty = 00000000-0000-4000-8000-000000000001.
ADMIN_DEV_SUB=
# Origins core-api accepts for cross-origin panel calls. Empty = http://127.0.0.1:8088 and http://localhost:8088.
ADMIN_ALLOWED_ORIGINS=
# core-api log level (info, debug, warn...). Empty = info.
LOG_LEVEL=
# Build argument: true shows the panel in presentation mode (test data always visible). Empty = true.
PANEL_PRESENTATION_MODE=