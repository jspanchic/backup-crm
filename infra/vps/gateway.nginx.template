# Gateway of the CRM test stack. It is the ONLY container that touches the Docker network of n8n; core-api itself stays on the
# internal network. nginx fills in N8N_UPSTREAM and WAHA_UPSTREAM from the environment (nginx image templates; see compose).
#
# :8080  what n8n may call (salvionix-core-api:8080 on the network of n8n): /tools/*, the health check and the WhatsApp webhook.
#        /admin/*, the REST proxy and everything else answer 403: they are reachable only from the panel, through the VPS loopback.
# :8081  core-api -> the bot: only POST /webhook/* of n8n.
# :8082  core-api -> WAHA: only POST sendSeen, startTyping, sendText, sendFile and stopTyping under /api/.
# Ports 8081 and 8082 are also visible from the network of n8n, but they only forward to n8n and WAHA, which are on it anyway.
resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;

server {
    listen 8080;
    set $core_api http://core-api:3000;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    location = /healthz {
        limit_except GET { deny all; }
        proxy_pass $core_api;
    }
    # Bot tools: JSON up to 16 KB (core-api enforces it too).
    location /tools/ {
        limit_except GET POST { deny all; }
        client_max_body_size 32k;
        proxy_pass $core_api;
    }
    # Signed WhatsApp webhook (WAHA). Nothing else of core-api is exposed.
    location = /hooks/whatsapp {
        limit_except POST { deny all; }
        client_max_body_size 1m;
        proxy_pass $core_api;
    }
    location / {
        return 403;
    }
}

server {
    listen 8081;
    set $n8n http://${N8N_UPSTREAM};
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;

    location /webhook/ {
        limit_except POST { deny all; }
        client_max_body_size 1m;
        proxy_pass $n8n;
    }
    location / {
        return 403;
    }
}

server {
    listen 8082;
    set $waha http://${WAHA_UPSTREAM};
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_next_upstream off;

    location = /api/sendSeen {
        limit_except POST { deny all; }
        client_max_body_size 32k;
        proxy_pass $waha;
    }
    location = /api/startTyping {
        limit_except POST { deny all; }
        client_max_body_size 32k;
        proxy_pass $waha;
    }
    location = /api/sendText {
        limit_except POST { deny all; }
        client_max_body_size 1m;
        proxy_pass $waha;
    }
    location = /api/sendFile {
        limit_except POST { deny all; }
        client_max_body_size 20m;
        proxy_pass $waha;
    }
    location = /api/stopTyping {
        limit_except POST { deny all; }
        client_max_body_size 32k;
        proxy_pass $waha;
    }
    location / {
        return 403;
    }
}
